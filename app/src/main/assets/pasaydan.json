{
 "id": "pasaydan",
 "title": "पसायदान",
 "author": "संत ज्ञानेश्वर महाराज",
 "kind": "prayer",
 "parts": [
  {
   "number": 1,
   "verses": [
    [
     "आतां विश्वात्मकें देवें",
     "येणें वाग्यज्ञें तोषावें",
     "तोषोनि मज द्यावें",
     "पसायदान हें"
    ]
   ]
  },
  {
   "number": 2,
   "verses": [
    [
     "जे खळांची व्यंकटी सांडो",
     "तयां सत्कर्मीं रती वाढो",
     "भूतां परस्परें जडो",
     "मैत्र जीवांचें"
    ]
   ]
  },
  {
   "number": 3,
   "verses": [
    [
     "दुरिताचें तिमिर जावो",
     "विश्व स्वधर्म सूर्यें पाहो",
     "जो जें वांच्छील तो तें लाहो",
     "प्राणिजात"
    ]
   ]
  },
  {
   "number": 4,
   "verses": [
    [
     "वर्षत सकळमंगळीं",
     "ईश्वर निष्ठांची मांदियाळी",
     "अनवरत भूमंडळीं",
     "भेटतु या भूतां"
    ]
   ]
  },
  {
   "number": 5,
   "verses": [
    [
     "चलां कल्पतरूंचे आरव",
     "चेतना चिंतामणीचें गाव",
     "बोलते जे अर्णव",
     "पीयूषाचे"
    ]
   ]
  },
  {
   "number": 6,
   "verses": [
    [
     "चंद्रमे जे अलांछन",
     "मार्तंड जे तापहीन",
     "ते सर्वांही सदा सज्जन",
     "सोयरे होतु"
    ]
   ]
  },
  {
   "number": 7,
   "verses": [
    [
     "किंबहुना सर्वसुखीं",
     "पूर्ण होऊनि तिहीं लोकीं",
     "भजिजो आदिपुरुखीं",
     "अखंडित"
    ]
   ]
  },
  {
   "number": 8,
   "verses": [
    [
     "आणि ग्रंथोपजीविये",
     "विशेषीं लोकीं इयें",
     "दृष्टादृष्ट विजयें",
     "होआवें जी"
    ]
   ]
  },
  {
   "number": 9,
   "verses": [
    [
     "येथ म्हणे श्रीविश्वेश्वरावो",
     "हा होईल दानपसावो",
     "येणें वरें ज्ञानदेवो",
     "सुखिया झाला"
    ]
   ]
  }
 ]
}